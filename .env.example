# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Transactional Email Provider Configuration (e.g., Resend or SMTP Webhook)
EMAIL_NOTIFICATIONS_ENABLED="false"
RESEND_API_KEY=""
DEALERSHIP_NOTIFICATION_EMAIL=""

# Optional Payment Provider (e.g., Paystack Ghana) - Keep disabled unless verified
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
